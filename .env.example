
# debug_investigate tool — both required for the tool to run.
# Empty values disable the tool (handler returns "configuration missing").
# Defaults assume self-hosted Prometheus on :9090 and Jaeger query API on :16686.
PROMETHEUS_URL=http://prometheus:9090
JAEGER_URL=http://jaeger:16686

# HTTP bearer auth, deny-by-default on the MCP listener (off | report | enforce; default off).
# Exempt (exact paths): /health, /health/live, /health/ready, /metrics, /resolve, /webhook/github.
# Tokens file: one token per line, each >= 32 bytes; re-read on change (inode/mtime/size).
# An empty or invalid reload keeps the previous tokens (it does NOT revoke): to revoke in an
# emergency, replace the file with the new set and recreate the service. In a container, mount
# the file's DIRECTORY, not the single file, or a rename-style edit is invisible.
# GO_CODE_HTTP_AUTH_MODE=off
# GO_CODE_HTTP_AUTH_TOKENS_FILE=/run/secrets/<dir>/tokens
